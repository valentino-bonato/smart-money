# ---------------------------------------------------------------- la app
# En local: la base con los datos reales.
# En Neon: la cadena CON "-pooler" en el host.
DATABASE_URL=postgres://user@localhost:5432/smart_money

# ------------------------------------------------------------ migraciones
# Solo hace falta en Neon: la cadena SIN "-pooler". El pooler corre en
# transaction mode y las migraciones usan features de sesión que ahí no
# existen. En local se puede dejar vacío.
# DIRECT_DATABASE_URL=

# --------------------------------------------------------------- pruebas
# Otra base: acá corren db:seed, db:verify y db:plan. El seed trunca todo y
# los verificadores esperan encontrar solo lo que el seed dejó.
TEST_DATABASE_URL=postgres://user@localhost:5432/smart_money_test
