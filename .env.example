# ---------------------------------------------------------------- la app
# En Neon: la cadena CON "-pooler" en el host. La escribe `neon link`.
DATABASE_URL=postgres://user@localhost:5432/smart_money

# ------------------------------------------------------------ migraciones
# La cadena SIN "-pooler". Neon la llama DATABASE_URL_UNPOOLED y la
# integración de Vercel la inyecta sola. El pooler corre en transaction mode
# y las migraciones usan features de sesión que ahí no existen.
# DATABASE_URL_UNPOOLED=

# --------------------------------------------------------------- pruebas
# Otra base: acá corren db:seed, db:verify y db:plan. El seed trunca todo y
# los verificadores esperan encontrar solo lo que el seed dejó.
TEST_DATABASE_URL=postgres://user@localhost:5432/smart_money_test
